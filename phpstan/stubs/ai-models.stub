<?php

// Static types for the laravel/ai conversation models.
//
// Their tables are resolved from runtime config (ai.conversations.tables.*),
// so migration scanning cannot map columns to properties. The shapes below
// mirror the package migrations and model casts.
//
// Note: `status` is typed as string (its column type) rather than the
// package's MessageStatus enum, because PHPStan cannot discover laravel/ai
// classes while validating stub PHPDocs.

namespace Laravel\Ai\Models;

/**
 * @property string $id
 * @property string $conversation_id
 * @property string|null $participant_type
 * @property string|null $participant_id
 * @property string $agent
 * @property string $role
 * @property string $content
 * @property array<string, mixed> $attachments
 * @property array<int, mixed> $steps
 * @property-read array<int, mixed> $tool_calls
 * @property-read array<int, mixed> $tool_results
 * @property-read array<int, mixed> $provider_tool_calls
 * @property array<string, mixed> $usage
 * @property array<string, mixed> $meta
 * @property string $status
 * @property mixed $created_at
 * @property mixed $updated_at
 */
class ConversationMessage extends \Illuminate\Database\Eloquent\Model
{
}

/**
 * @property string $id
 * @property string|null $participant_type
 * @property string|null $participant_id
 * @property string $title
 * @property mixed $created_at
 * @property mixed $updated_at
 */
class Conversation extends \Illuminate\Database\Eloquent\Model
{
}
