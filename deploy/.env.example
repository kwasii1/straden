# ---------------------------------------------------------------------------
# Straden — every value here is optional. Copy to `.env` next to compose.yaml.
# ---------------------------------------------------------------------------

# Where Straden is reachable.
#   Local:  STRADEN_DOMAIN=:80  + APP_URL=http://localhost:8000
#   VPS:    STRADEN_DOMAIN=straden.example.com + APP_URL=https://straden.example.com
#           + HTTP_PORT=80 + HTTPS_PORT=443 (HTTPS certificates are automatic)
STRADEN_DOMAIN=:80
APP_URL=http://localhost:8000
HTTP_PORT=8000
HTTPS_PORT=8443

# Image version to run (see GitHub releases). Pin it in production.
STRADEN_VERSION=latest

# First admin account. Leave empty to create it in the browser on first visit
# (recommended). Only used when the instance has no users yet — remove the
# password once the account exists.
STRADEN_ADMIN_NAME=
STRADEN_ADMIN_EMAIL=
STRADEN_ADMIN_PASSWORD=

# Database password. Change before the first start; it can't be changed by
# editing this file afterwards.
DB_PASSWORD=straden

# Secrets are generated automatically on first boot and stored in the
# `storage` volume (storage/app/.straden-secrets). Set them here only if you
# want to manage them yourself. Losing APP_KEY makes stored AI keys unreadable.
# APP_KEY=
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=

# Mail (optional — used for notifications and password resets).
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=straden@example.com
