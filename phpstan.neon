includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    stubFiles:
        - phpstan/stubs/ai-models.stub

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Parse casts() methods statically: Laravel merges them into $casts only
    # inside the model constructor, which Larastan bypasses when inspecting
    # models. Without this, enum/datetime/array casts resolve as raw column types.
    parseModelCastsMethod: true
